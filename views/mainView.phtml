<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Gestor de Tareas</title>
</head>
<body>

    <?php if (isset($_SESSION['user'])): ?>
        <p>
            Hola, <strong><?php echo htmlspecialchars($_SESSION['user']->getUsername()); ?></strong> |
            <a href="index.php?c=task&new">Crear tarea</a> |
            <a href="index.php?logout">Cerrar sesión</a>
        </p>

        <hr>

        <h2>Mis Tareas</h2>

        <?php if (!empty($tasks)): ?>
            <ul>
                <?php foreach ($tasks as $task): ?>
                    <li style="margin-bottom: 15px;">
                        <strong><?php echo htmlspecialchars($task->getTitle()); ?></strong>
                        <?php if ($task->getDescription()): ?>
                            — <?php echo htmlspecialchars($task->getDescription()); ?>
                        <?php endif; ?>

                        <strong>[<?php echo $task->isCompleted() ? 'Completada' : 'Pendiente'; ?>]</strong>

                        <a href="index.php?c=task&toggle=<?php echo $task->getId(); ?>&status=<?php echo $task->isCompleted() ? 1 : 0; ?>">
                            (<?php echo $task->isCompleted() ? 'Marcar pendiente' : 'Marcar completada'; ?>)
                        </a>

                        <?php if ($task->getUserId() == $_SESSION['user']->getId()): ?>
                            | <a href="index.php?c=task&delete=<?php echo $task->getId(); ?>" onclick="return confirm('¿Seguro que deseas borrarla?');">[Eliminar]</a>

                            <!-- Formulario para compartir con otros usuarios -->
                            <?php if (!empty($otherUsers)): ?>
                                <form action="index.php?c=task&share" method="POST" style="display:inline-block; margin-left: 10px;">
                                    <input type="hidden" name="task_id" value="<?php echo $task->getId(); ?>">
                                    <select name="user_id" required>
                                        <option value="">Compartir con...</option>
                                        <?php foreach ($otherUsers as $ou): ?>
                                            <option value="<?php echo $ou->getId(); ?>">
                                                <?php echo htmlspecialchars($ou->getUsername()); ?>
                                            </option>
                                        <?php endforeach; ?>
                                    </select>
                                    <button type="submit">Compartir</button>
                                </form>
                            <?php endif; ?>
                        <?php else: ?>
                            <em>(Compartida contigo)</em>
                        <?php endif; ?>
                    </li>
                <?php endforeach; ?>
            </ul>
        <?php else: ?>
            <p>No tienes tareas asignadas ni compartidas.</p>
        <?php endif; ?>

    <?php else: ?>
        <p>Bienvenido al gestor de tareas. Por favor, identifícate:</p>
        <a href="index.php?c=user&login">Entrar</a> |
        <a href="index.php?c=user&register">Regístrate</a>
    <?php endif; ?>

    <?php if (isset($_SESSION['user'])): ?>
    <hr>

    <!-- 1. FORMULARIO PARA CREAR NUEVA CATEGORÍA -->
    <h2>Gestión de Categorías</h2>
    <h3>Crear Nueva Categoría</h3>
    <form action="index.php?c=task&newCategory" method="POST">
        <input type="text" name="category_name" placeholder="Nombre de la categoría" required>
        <button type="submit">Crear</button>
    </form>

    <br>

    <!-- LISTADO DE CATEGORÍAS EXISTENTES -->
    <?php if (!empty($categories)): ?>
        <h3>Categorías Existentes:</h3>
        <ul>
            <?php foreach ($categories as $cat): ?>
                <li>
                    <?php echo htmlspecialchars($cat['name']); ?>
                    | <a href="index.php?c=task&deleteCategory=<?php echo $cat['id']; ?>" onclick="return confirm('¿Seguro que deseas eliminar esta categoría?');" style="color: red;">[Eliminar]</a>
                </li>
            <?php endforeach; ?>
        </ul>

        <hr>

        <!-- 2. FORMULARIO PARA ASIGNAR CATEGORÍA A TAREA -->
        <?php if (!empty($tasks)): ?>
            <h2>Categorizar Tareas</h2>
            <form action="index.php?c=task&categorize" method="POST">
                <label for="task_id">Selecciona una tarea:</label>
                <select name="task_id" id="task_id" required>
                    <?php foreach ($tasks as $task): ?>
                        <option value="<?php echo $task->getId(); ?>">
                            <?php echo htmlspecialchars($task->getTitle()); ?>
                        </option>
                    <?php endforeach; ?>
                </select>

                <label for="category_id">Selecciona una categoría:</label>
                <select name="category_id" id="category_id" required>
                    <?php foreach ($categories as $cat): ?>
                        <option value="<?php echo $cat['id']; ?>">
                            <?php echo htmlspecialchars($cat['name']); ?>
                        </option>
                    <?php endforeach; ?>
                </select>

                <button type="submit">Categorizar</button>
            </form>
        <?php endif; ?>

    <?php else: ?>
        <p><em>No tienes categorías creadas todavía. Crea una arriba para poder asignarla.</em></p>
    <?php endif; ?>

<?php endif; ?>

<?php if (!empty($categories)): ?>
    <hr>
    <h2>Filtrar Tareas por Categoría</h2>
    <ul>
        <?php foreach ($categories as $cat): ?>
            <li>
                <a href="index.php?c=task&category=<?php echo $cat['id']; ?>">
                    <?php echo htmlspecialchars($cat['name']); ?>
                </a>
            </li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>

</body>
</html>